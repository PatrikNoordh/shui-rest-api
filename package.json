{
  "name": "shui-rest-api",
  "version": "1.0.0",
  "description": "REST API for the Shui message board, built with AWS Lambda, API Gateway and DynamoDB",
  "private": true,
  "scripts": {
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrikNoordh/shui-rest-api.git"
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1175.0",
    "@aws-sdk/lib-dynamodb": "^3.1175.0",
    "@middy/core": "^7.9.2",
    "@middy/http-json-body-parser": "^7.9.2",
    "@middy/util": "^7.9.2",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
